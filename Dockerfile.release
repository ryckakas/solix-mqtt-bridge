# Release image: goreleaser (dockers_v2) puts each platform's prebuilt binary under $TARGETPLATFORM/ in the context.
FROM gcr.io/distroless/static:nonroot@sha256:e2e927ec666bae08560abb3c55d0659eceabb657f56b6782ab500a9fc7f555e3
ARG TARGETPLATFORM
COPY $TARGETPLATFORM/solix-mqtt-bridge /solix-mqtt-bridge
USER nonroot:nonroot
ENTRYPOINT ["/solix-mqtt-bridge"]
