# solix-mqtt-bridge configuration. Replace every <placeholder> below with your own value.

# Solarbank Modbus TCP interface (enable it in the Anker app: device > gear > Three-Party Control Settings).
SOLARBANK_ADDR=<solarbank-ip>
#SOLARBANK_UNIT_ID=1
#POLL_INTERVAL=5s
#STALE_AFTER=30s

# Generic MQTT output (any broker). Comment out MQTT_URL to disable it.
MQTT_URL=tcp://<broker-ip>:1883
#MQTT_BASE_TOPIC=solix-mqtt-bridge
#MQTT_USERNAME=
#MQTT_PASSWORD=

# openWB 2.x output. OPENWB_BAT_ID is the component id of the generic MQTT battery configured in openWB.
#OPENWB_MQTT_URL=tcp://<openwb-ip>:1883
#OPENWB_BAT_ID=<component id>
#OPENWB_PUBLISH_COUNTERS=false

#LOG_LEVEL=info
#LOG_FORMAT=text

# Optional daily log files, deleted after LOG_RETENTION_DAYS. The systemd unit provides /var/log/solix-mqtt-bridge;
# in Docker use /logs and uncomment the volume in docker-compose.yml.
#LOG_DIR=/var/log/solix-mqtt-bridge
#LOG_RETENTION_DAYS=7
#LOG_FILE_LEVEL=debug
